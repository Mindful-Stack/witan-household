{
  "enabledPlugins": {
    "lore@witan": true
  },
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git blame:*)",
      "Bash(git fetch:*)",
      "Bash(git branch)",
      "Bash(git branch -l:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch -a:*)",
      "Bash(git branch -r:*)",
      "Bash(git branch -v:*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git describe:*)",
      "Bash(git reflog:*)",
      "Bash(git shortlog:*)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git remote show:*)",
      "Bash(git remote get-url:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git stash list:*)",
      "Bash(git stash show:*)",
      "Bash(git worktree list:*)",
      "Bash(git tag -l:*)",
      "Bash(git tag --list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore --staged:*)",

      "Bash(cd ./* && git log:*)",
      "Bash(cd ./* && git show:*)",
      "Bash(cd ./* && git diff:*)",
      "Bash(cd ./* && git status:*)",
      "Bash(cd ./* && git blame:*)",
      "Bash(cd ./* && git fetch:*)",
      "Bash(cd ./* && git branch)",
      "Bash(cd ./* && git branch -l:*)",
      "Bash(cd ./* && git branch --list:*)",
      "Bash(cd ./* && git branch -a:*)",
      "Bash(cd ./* && git branch -r:*)",
      "Bash(cd ./* && git rev-parse:*)",
      "Bash(cd ./* && git ls-files:*)",
      "Bash(cd ./* && git remote)",
      "Bash(cd ./* && git remote -v)",
      "Bash(cd ./* && git config --get:*)",
      "Bash(cd ./* && git stash list:*)",
      "Bash(cd ./* && git tag -l:*)",
      "Bash(cd ./* && git add:*)",
      "Bash(cd ./* && git commit:*)",
      "Bash(cd ./* && git restore --staged:*)",

      "Bash(git -C ./* log:*)",
      "Bash(git -C ./* show:*)",
      "Bash(git -C ./* diff:*)",
      "Bash(git -C ./* status:*)",
      "Bash(git -C ./* blame:*)",
      "Bash(git -C ./* fetch:*)",
      "Bash(git -C ./* branch)",
      "Bash(git -C ./* branch -l:*)",
      "Bash(git -C ./* branch --list:*)",
      "Bash(git -C ./* branch -a:*)",
      "Bash(git -C ./* branch -r:*)",
      "Bash(git -C ./* rev-parse:*)",
      "Bash(git -C ./* ls-files:*)",
      "Bash(git -C ./* remote)",
      "Bash(git -C ./* remote -v)",
      "Bash(git -C ./* config --get:*)",
      "Bash(git -C ./* stash list:*)",
      "Bash(git -C ./* tag -l:*)",
      "Bash(git -C ./* add:*)",
      "Bash(git -C ./* commit:*)",
      "Bash(git -C ./* restore --staged:*)"
    ]
  }
}
